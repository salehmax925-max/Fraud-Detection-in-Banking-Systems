# ═══════════════════════════════════════════════════════════════════════
#  FraudShield AI — Production Environment Variables for Render Backend
#  Copy this file and fill in real values in the Render dashboard.
#  NEVER commit the real .env file with secrets to GitHub.
# ═══════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────
# Render PostgreSQL (Internal URL — use Internal DB URL from Render dashboard)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/frauddb
DATABASE_SYNC_URL=postgresql+psycopg2://user:password@host:5432/frauddb

# ── Model & Data Paths (inside Docker container) ─────────────────────────
MODEL_DIR=/app/models
PROCESSED_DATA_DIR=/app/data/processed

# ── Model Verification ───────────────────────────────────────────────────
# Set to True on first deploy to skip verification while warming up
SKIP_MODEL_VERIFICATION=False

# ── CORS (your Vercel frontend URL) ─────────────────────────────────────
# Replace with your actual Vercel URL after deployment
CORS_ORIGINS=https://fraudshield-ai.vercel.app,https://www.fraudshield-ai.vercel.app

# ── Fraud Detection Thresholds ───────────────────────────────────────────
DEFAULT_BLOCK_THRESHOLD=0.85
DEFAULT_REVIEW_THRESHOLD=0.50

# ── Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# ── App Settings ─────────────────────────────────────────────────────────
DEBUG=False
ENVIRONMENT=production

# ── Ollama ───────────────────────────────────────────────────────────────
# Ollama cannot run on Render free tier (needs GPU/persistent storage).
# The AI Chat will auto-fall back to rule-based responses when Ollama is offline.
# To enable Ollama, use a GPU instance or point to a self-hosted URL:
# OLLAMA_BASE_URL=https://your-ollama-server.com
OLLAMA_BASE_URL=http://localhost:11434
