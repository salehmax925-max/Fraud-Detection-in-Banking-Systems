# ═══════════════════════════════════════════════════════════════════════════
#  FraudShield AI — Backend Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit .env or any file with real secrets to Git.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL (production):
#   DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local PostgreSQL (development):
#   DATABASE_URL=postgresql+asyncpg://fraud:fraud_pass@127.0.0.1:5432/frauddb
DATABASE_URL=postgresql+asyncpg://fraud:fraud_pass@127.0.0.1:5432/frauddb

# Sync URL for psycopg2 (PandasDataAgent analytics)
# Neon: replace asyncpg with psycopg2, keep rest identical
DATABASE_SYNC_URL=postgresql+psycopg2://fraud:fraud_pass@127.0.0.1:5432/frauddb

# ── Model Artifacts ────────────────────────────────────────────────────────
# In Docker container these are /app/models and /app/data/processed
# In local dev these auto-resolve relative to the project root
MODEL_DIR=/app/models
PROCESSED_DATA_DIR=/app/data/processed

# ── Model Verification ─────────────────────────────────────────────────────
# True = skip SHA-256 checksum subprocess (safe in Docker/production)
# False = run full verification (use locally when testing model integrity)
SKIP_MODEL_VERIFICATION=True

# ── CORS Origins (comma-separated) ────────────────────────────────────────
# Add your Vercel URL here:
CORS_ORIGINS=https://fraudshield-ai.vercel.app,http://localhost:5173,http://localhost:3000

# ── Fraud Detection Thresholds ─────────────────────────────────────────────
DEFAULT_BLOCK_THRESHOLD=0.85
DEFAULT_REVIEW_THRESHOLD=0.50

# ── JWT Security ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Ollama (AI Chat + LLM Explain) ────────────────────────────────────────
# Local: http://localhost:11434
# Remote VPS: http://your-server-ip:11434
# Leave as localhost if Ollama runs in same container/host as the backend
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── Application ────────────────────────────────────────────────────────────
DEBUG=False
ENVIRONMENT=production
